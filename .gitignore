__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------------------
# Zugangsdaten - NIEMALS committen
# API-Schluessel und Kontaktadressen stehen in .env. Die Vorlage
# .env.beispiel ist bewusst versioniert und enthaelt nur Platzhalter.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.beispiel

# ---------------------------------------------------------------------------
# Generierte Ergebnisdateien
# Alle Anwendungen hier schreiben Vorschlagslisten, Entwuerfe und Graphen -
# also Momentaufnahmen eines Laufs, keinen Quellcode. Sie bleiben deshalb
# ausserhalb der Versionierung; einzige Ausnahme ist
# benchmark/properties_snapshot.json (siehe unten).
# ---------------------------------------------------------------------------

# wikikg (--output, per Konvention nach output/)
output/

# ---------------------------------------------------------------------------
# materialswiki (--out / --qs-out) und lauf.py
#
# Die Dateinamen tragen Gruppe und Zeitstempel und im Chargenbetrieb zusaetzlich
# eine Chargennummer, z. B.
#     vorschlaege_minerale_2026-08-16_1844_charge04.csv
#     quickstatements_minerale_2026-08-16_1844_charge04.txt
#     quickstatements_minerale_2026-08-16_1844.fortschritt.json
# Die Muster sind deshalb bewusst weit gefasst - ein enges Muster wie
# "quickstatements_entwurf*.txt" hat die Chargendateien nicht mehr erfasst.
# ---------------------------------------------------------------------------
vorschlaege*.csv
vorschlaege*.log
quickstatements*.txt
quickstatements*.fortschritt.json

# aeltere Multi-Source-Variante (--out / --qs-out)
werkstoffe_vorschlaege.csv
werkstoffe_quickstatements_entwurf.txt

# benchmark/benchmark.py (--csv) und die Protokolle aus lauf.py.
# benchmark/properties_snapshot.json ist bewusst versioniert, damit --offline
# reproduzierbar bleibt - kein Muster hier darf es treffen.
abdeckung*.csv
benchmark_*.log

# P279-structure/P279benchmark.py (--csv; der Entwurf faellt schon unter
# das Muster quickstatements*.txt weiter oben)
p279_befunde*.csv

# Anwendung/Anwendung.py (--csv; der Entwurf faellt schon unter
# das Muster quickstatements*.txt weiter oben)
anwendungen_befunde*.csv

# Kategorie Hirachie/material_hierarchy_check.py (CSV + Graphen)
werkstoff_check.csv
werkstoff_graph.png
subclass_tree_material.png
trace_*.png
