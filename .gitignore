__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.wikikg
.proposals

# ---------------------------------------------------------------------------
# Zugangsdaten - NIEMALS committen
# API-Schluessel und Kontaktadresse stehen in .env.api-keys im
# Repo-Wurzelverzeichnis. konfig.py spiegelt die Datei beim Import in die
# Umgebung; committet wird sie nie.
# ---------------------------------------------------------------------------
.env
.env.*

# ---------------------------------------------------------------------------
# Generierte Ergebnisdateien
# Alle Anwendungen hier schreiben Vorschlagslisten, Entwuerfe und Graphen -
# also Momentaufnahmen eines Laufs, keinen Quellcode. Sie bleiben deshalb
# ausserhalb der Versionierung; einzige Ausnahme ist
# benchmark/properties_snapshot.json (siehe unten).
# ---------------------------------------------------------------------------

# wikikg (--output, per Konvention nach output/)
output/

# ---------------------------------------------------------------------------
# materialswiki (--out / --qs-out) und lauf.py
#
# Die Dateinamen tragen Gruppe und Zeitstempel und im Chargenbetrieb zusaetzlich
# eine Chargennummer, z. B.
#     vorschlaege_minerale_2026-08-16_1844_charge04.md
#     qs_minerale_2026-08-16_1844_charge04.txt
#     qs_minerale_2026-08-16_1844.fortschritt.json
# Die Muster sind deshalb bewusst weit gefasst - ein enges Muster wie
# "qs_entwurf*.txt" hat die Chargendateien nicht mehr erfasst.
# ---------------------------------------------------------------------------
vorschlaege*.md
vorschlaege*.log
qs_*.txt
qs_*.fortschritt.json

# aeltere Multi-Source-Variante (--out / --qs-out)
werkstoffe_vorschlaege.md
werkstoffe_qs_entwurf.txt

# benchmark/benchmark.py (--md) und die Protokolle aus lauf.py.
# benchmark/properties_snapshot.json ist bewusst versioniert, damit --offline
# reproduzierbar bleibt - kein Muster hier darf es treffen.
abdeckung*.md
benchmark_*.log

# Material class structure/ClassCheck.py: die gestaffelte Empfehlung (--out,
# qs_class_*.txt faellt schon unter qs_*.txt weiter oben) und der optionale
# Befundbericht (--md), der ein eigenes Muster braucht.
qs_class*.log
qs_class_befunde*.md

# Anwendung/Anwendung.py (--md; der Entwurf qs_anwendungen_*.txt faellt
# schon unter das Muster qs_*.txt weiter oben) und das Protokoll aus lauf.py.
anwendungen_befunde*.md
anwendungen_*.log

# Altbestand vor der qs_-Umbenennung (quickstatements_* -> qs_*,
# p279_empfehlung_* -> qs_class_*). Aeltere Laufdateien tragen noch die
# alten Namen und sollen weiter ignoriert bleiben.
quickstatements*.txt
quickstatements*.fortschritt.json
p279_empfehlung*.txt
p279_empfehlung*.log
p279_befunde*.csv

# Material class structure/visualisierung.py (Graphen)
subclass_tree_material.png
trace_*.png
szenario_*.png
szenario_*.md

# Visualisierung/Diagramme.ipynb: die eigenstaendige Diagrammseite und der
# Zwischenspeicher der SPARQL-Antwort. Beides ist reproduzierbar - das
# Notebook holt die Daten mit einem Lauf neu.
dichte_ueber_raumgruppe.html
wikidata_dichte_raumgruppe.json

# Arbeitsverzeichnisse, die nicht ins Repo gehoeren:
#   Archiv/         abgelegte Laufergebnisse frueherer Durchgaenge
#   Visualisierung/ Diagramm-Werkstatt (Notebook, Skript und die daraus
#                   erzeugten HTML-Seiten und JSON-Zwischenspeicher)
Archiv/
Visualisierung/

# Claude-Code-Arbeitsdateien: Projektregeln und Projektgedaechtnis. Beides ist
# lokale Werkzeugkonfiguration, keine Projektquelle.
.claude/rules/
CLAUDE.md
