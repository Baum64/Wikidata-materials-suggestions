# Vorlage fuer .env - diese Datei hier ist versioniert und enthaelt NUR
# Platzhalter. Zum Einrichten:
#
#     cp .env.beispiel .env
#     chmod 600 .env
#     # dann .env ausfuellen
#
# .env selbst ist in .gitignore eingetragen und wird nie committet.
# Einzelne Werte lassen sich pro Lauf ueberschreiben:
#     MP_API_KEY=zweitschluessel python -m materialswiki --periodic-table


# --- API-Schluessel --------------------------------------------------------

# Materials Project, kostenlos unter
# https://next-gen.materialsproject.org/api
# Pflicht fuer materialswiki - ohne ihn antwortet die API mit HTTP 401.
MP_API_KEY=

# Materials Project (optional, nur fuer das Multi-Source-Skript, falls dort
# ein eigener Schluessel verwendet werden soll). Leer = MP_API_KEY wird genutzt.
MP_API_KEY_WERKSTOFFE=


# --- Kontakt ---------------------------------------------------------------

# Landet im User-Agent aller Abfragen. Die Wikimedia-User-Agent-Richtlinie
# verlangt eine echte, erreichbare Adresse:
# https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
CONTACT_EMAIL=deine-adresse@example.org

# Klarname fuer den User-Agent (optional).
CONTACT_NAME=

# --- Accounts (nur zur Dokumentation, werden nicht abgefragt) --------------

# Mit welchem Konto der MP-Schluessel verknuepft ist - hilfreich, wenn er
# einmal rotiert werden muss.
MP_ACCOUNT_EMAIL=

# Wikidata-Benutzername, unter dem die QuickStatements eingespielt werden.
WIKIDATA_USERNAME=
